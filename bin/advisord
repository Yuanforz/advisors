#!/usr/bin/env python3
"""The advisord daemon. Entry point for running from a checkout; `pip install` provides the same commands.

The advisors command starts the daemon when needed, so there is usually no reason to run this by hand.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from advisors.daemon import main  # noqa: E402

sys.exit(main())
